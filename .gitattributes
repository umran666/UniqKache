# Normalise line endings on checkout and commit.
#
# Without this, a Windows checkout rewrites every text file to CRLF, and the
# next commit shows the entire repository as modified. That makes review
# impossible and would bury a real change in thousands of whitespace diffs.
#
# `text=auto` lets git detect text files and store them with LF in the
# repository; `eol=lf` makes the working copy LF too, on every platform, so a
# file hashed on Windows and on Linux is the same file.
* text=auto eol=lf

# --- Binary files: never touch these ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pt binary
*.pth binary
*.safetensors binary
*.bin binary
*.npz binary
*.onnx binary

# --- Git housekeeping ---
# Keep these normalised so the tools that read them are not confused by CRLF.
*.py text
*.pyi text
*.toml text
*.yaml text
*.yml text
*.json text
*.md text
*.cff text
*.cfg text
*.txt text
*.ini text
Makefile text

# `*.bat` and `*.cmd` require CRLF on Windows, so they are the exception.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Generated files: exclude from `git diff` and language statistics ---
*.csv linguist-generated=true
*.jsonl linguist-generated=true
