# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Experiment artefacts ---
# Raw run outputs are large and machine-specific. Committed results live in
# experiments/results/ as small, curated, machine-readable summaries only.
experiments/results/runs/
experiments/results/raw/
experiments/results/*.tmp

# --- Model / dataset caches ---
# Anchored to the repository root on purpose. A bare `models/` pattern matches
# a directory named `models` at *any* depth, which silently excluded
# `src/uniqkache/models/` from the repository when this file was first written.
/.cache/
/hf_cache/
/models/
/datasets/

# --- Secrets ---
.env
*.pem
*.key

# --- Local assistant / editor state ---
# Local working notes and session state. Useful on this machine, machine-specific,
# and not part of the research record, so it stays out of the repository.
.workbuddy-ai/
